APP_ENV=local
LOG_LEVEL=INFO
# local only -- on AWS this comes from Secrets Manager
OPENAI_API_KEY=sk-...
# "pgvector" (needs Postgres via docker-compose.local.yml) or "numpy" for a zero-Docker run
VECTOR_BACKEND=pgvector
POSTGRES_DSN=postgresql://claims:claims@localhost:5432/claims
SQLITE_PATH=./.local/checkpoints.sqlite
USE_REDIS=false
USE_TEXTRACT=false
USE_S3=false
USE_SECRETS_MANAGER=false
DOCUMENTS_DIR=./data/documents
FIXTURE_DIR=./tests/fixtures/textract
